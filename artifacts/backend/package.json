{
  "name": "insuremithra-backend",
  "version": "1.0.0",
  "description": "Insurance Workflow Automation System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node start-server.js",
    "dev": "nodemon start-server.js",
    "server": "node server.js",
  "test": "jest",
  "test:watch": "jest --watch",
  "test:ci": "node -e \"require('fs').mkdirSync('reports/junit', { recursive: true })\" && jest --runInBand --forceExit --reporters=default --reporters=jest-junit",
  "test:backend": "jest --testPathPattern=tests --runInBand --config=jest.config.cjs",
  "coverage:backend": "jest --coverage --coverageDirectory=coverage --coverageReporters=json-summary --coverageReporters=lcov --testPathPattern=tests --config=jest.config.cjs",
  "lint": "eslint . --ext .js",
  "lint:ci": "node scripts/save-eslint-report.js",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "husky install"
  },
  "keywords": [
    "insurance",
    "workflow",
    "automation",
    "api"
  ],
  "author": "InsureMithra Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.4",
    "multer": "^2.0.2",
    "pdfkit": "^0.13.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "^11.1.0",
    "jest-junit": "^16.0.0",
    "nyc": "^15.1.0",
    "mongodb-memory-server": "^8.11.0",
    "prettier": "^3.3.3",
    "husky": "^8.0.0"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  },
  "nyc": {
    "all": true,
    "check-coverage": false,
    "include": ["**/*.js"],
    "exclude": ["**/*.test.*", "frontend/**", "node_modules/**"],
    "statements": 75,
    "branches": 75,
    "functions": 75,
    "lines": 75
  }
}
