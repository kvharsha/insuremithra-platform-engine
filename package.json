{
  "name": "insuremithra-backend",
  "version": "1.0.0",
  "description": "Insurance Workflow Automation System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node start-server.js",
    "dev": "nodemon start-server.js",
    "server": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "node -e \"require('fs').mkdirSync('reports/junit', { recursive: true })\" && jest --runInBand --forceExit --reporters=default --reporters=jest-junit",
    "env-check": "node scripts/env-check.js",
    "test:backend": "jest --testPathPattern=tests --runInBand --config=jest.config.cjs",
    "test:renewal": "jest tests/renewal.test.js --coverage --collectCoverageFrom='controllers/renewal.controller.js' --collectCoverageFrom='routes/renewal.routes.js' --collectCoverageFrom='models/renewal.model.js' --collectCoverageFrom='services/payment.service.js' --collectCoverageFrom='utils/renewalCalculator.js' --collectCoverageFrom='utils/transactionId.js'",
    "test:downtime": "jest tests/downtime.test.js --coverage --collectCoverageFrom='services/health.service.js' --collectCoverageFrom='services/downtime.service.js' --collectCoverageFrom='services/alert.service.js' --collectCoverageFrom='scheduler/downtimeMonitor.js' --collectCoverageFrom='models/downtime.model.js'",
    "monitor:test": "node -e \"require('./scheduler/downtimeMonitor').runHealthCheck().then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1);})\"",
    "coverage:backend": "jest --coverage --coverageDirectory=coverage --coverageReporters=json-summary --coverageReporters=lcov --testPathPattern=tests --config=jest.config.cjs",
    "bench:search": "node tools/load-test/policy-search-autocannon.js",
    "bench:details": "node tools/load-test/policy-details-autocannon.js",
    "lint": "eslint . --ext .js",
    "lint:ci": "node scripts/save-eslint-report.js",
    "security:audit": "npm audit --audit-level=high",
    "scan:deps": "npm audit --audit-level=moderate",
    "scan:zap": "bash tools/security/zap-scan.sh",
    "verify:backups": "node tools/verify-backups.js"
  },
  "keywords": [
    "insurance",
    "workflow",
    "automation",
    "api"
  ],
  "author": "InsureMithra Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.1.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.0.1",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "tar": "^6.1.11",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "autocannon": "^7.12.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.6.2",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
