# InsureMithra — environment configuration
# Copy to .env and fill in real values. Never commit a populated .env.
#   cp .env.example .env && npm run env-check

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/insuremithra
MONGO_URI=mongodb://localhost:27017/insuremithra
DB_NAME=insuremithra

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# Rate limiting (applied to /api/auth)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================
# EMAIL (password resets, receipts, alerts)
# Use an app-specific password, not your account password.
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password

# Backwards-compatible aliases (some modules read EMAIL_*)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=InsureMithra <no-reply@insuremithra.com>
FROM_EMAIL=InsureMithra <no-reply@insuremithra.com>

# ============================================
# CACHING & PERFORMANCE
# ============================================
# Leave REDIS_URL empty to use the in-memory LRU fallback.
REDIS_URL=redis://localhost:6379
USE_REDIS=true

# Cache TTLs (seconds)
CACHE_DEFAULT_TTL=300
CACHE_POLICY_SEARCH_TTL=60
CACHE_POLICY_DETAIL_TTL=300
CACHE_USER_PURCHASES_TTL=30
CACHE_USER_CLAIMS_TTL=30

ENABLE_COMPRESSION=true

# ============================================
# FILE UPLOAD (claim documents)
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ============================================
# MONITORING & BACKUPS
# ============================================
MONITOR_INTERVAL_MINUTES=10
DOWN_ALERT_THRESHOLD_MS=300000
# ALERT_WEBHOOK_URL=
# DISABLE_BACKUP_SCHEDULER=false
# SERVER_TIMEZONE=Asia/Kolkata

# ============================================
# BENCHMARKING (npm run bench:*)
# ============================================
BASE_URL=http://localhost:5001
BENCH_DURATION=30
BENCH_CONNECTIONS=50
BENCH_PIPELINING=1
# Comma-separated policy IDs used by the load tests
POLICY_IDS=507f1f77bcf86cd799439011,507f1f77bcf86cd799439012
